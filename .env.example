# JETZ Sports Academy — Backend environment template
# Copy to .env and fill in. NEVER commit real secrets.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Database (PostgreSQL)
DB_NAME=jetz_db
DB_USER=jetz_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT — session lifetimes (minutes)
#   ACCESS: short-lived bearer token the apps silently refresh.
#   SESSION: absolute cap on one login before a re-login is required (default 720 = 12h).
#   REFRESH: must be >= SESSION; a legacy JWT_REFRESH_DAYS (days) key is also accepted.
JWT_ACCESS_MINUTES=30
JWT_SESSION_MINUTES=720
JWT_REFRESH_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Payment gateway (CONFIGURATION REQUIRED — no default provider credentials)
# Options: mock | razorpay | stripe
# Webhooks verify signatures server-side and FAIL CLOSED when the matching
# secret is unset, so webhook-driven "payment success" cannot be forged.
PAYMENT_GATEWAY_PROVIDER=mock
MOCK_WEBHOOK_SECRET=change-me-mock-webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp provider (CONFIGURATION REQUIRED for real delivery)
# Options: mock | meta_cloud | twilio
# Real-time Meta Cloud setup:
#  1. Meta App (developers.facebook.com) + WhatsApp product + test or live number
#  2. Permanent System-User access token  -> WHATSAPP_API_TOKEN
#  3. Phone Number ID (WhatsApp > API Setup) -> WHATSAPP_PHONE_NUMBER_ID
#  4. Create + get APPROVED message templates in WhatsApp Manager; mirror each
#     one (same name + language + {{1}} params) on the Admin WhatsApp page
#  5. Webhook: subscribe with a public https URL to /api/whatsapp/webhook/
#     (GET verify token below, POST receives sent/delivered/read/failed)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify
WHATSAPP_DEFAULT_TEMPLATE_LANG=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Media / storage (local by default; S3-compatible optional)
MEDIA_ROOT=media
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=

# Redis / Celery (optional; falls back to sync execution)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ---- Photo attendance / face matching (trainer app) ----
# ATTENDANCE_VISION_PROVIDER: pilot (evidence + coach-confirmed review, no
# biometrics) or faceauth (AWS Rekognition match against consented student
# reference photos). Face Liveness (FACE_*) is only needed for the HR flow.
# Verify what a running server actually selected with:
#   python manage.py face_provider_status --check-aws
ATTENDANCE_VISION_PROVIDER=pilot
FACE_VERIFICATION_PROVIDER=aws
AWS_REGION=ap-south-1
AWS_REKOGNITION_COLLECTION_PREFIX=jetz
FACE_MATCH_THRESHOLD=90
FACE_GROUP_MATCH_THRESHOLD=90
FACE_GROUP_REVIEW_THRESHOLD=80
FACE_GROUP_AMBIGUITY_MARGIN=3

# Fee config note: fee amounts are DB-driven (FeePlan). No amounts in env.
# Trainer rates are DB-driven (TrainerFeeRule). No rates in env.
